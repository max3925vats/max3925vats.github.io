{% assign featured = site.data.talks | where: 'selected', true | first %}
{% if featured %}
  <div class="publications">
    <ol class="bibliography">
      <li>
        <div class="row">
          <div class="col col-sm-2 abbr"></div>
          <div class="col-sm-8">
            <div class="title">{{ featured.title }}</div>
            <div class="author">
              <em>{{ featured.venue }}</em>
            </div>
            <div class="periodical">
              {% if featured.location %}{{ featured.location }}, {% endif -%}
              {{- featured.date | date: '%b %Y' }}
            </div>
            {% if featured.abstract or featured.slides or featured.poster or featured.url %}
              <div class="links">
                {% if featured.abstract -%}
                  <a class="abstract btn btn-sm z-depth-0" role="button">Abs</a>
                {%- endif %}
                {% if featured.slides -%}
                  <a href="{{ featured.slides }}" class="btn btn-sm z-depth-0" role="button" rel="external nofollow noopener" target="_blank"
                    >Slides</a
                  >
                {%- endif %}
                {% if featured.poster -%}
                  <a href="{{ featured.poster }}" class="btn btn-sm z-depth-0" role="button" rel="external nofollow noopener" target="_blank"
                    >Poster</a
                  >
                {%- endif %}
                {% if featured.url -%}
                  <a href="{{ featured.url }}" class="btn btn-sm z-depth-0" role="button" rel="external nofollow noopener" target="_blank">Event</a>
                {%- endif %}
              </div>
              {% if featured.abstract %}
                <div class="abstract hidden">
                  <p>{{ featured.abstract }}</p>
                </div>
              {% endif %}
            {% endif %}
          </div>
        </div>
      </li>
    </ol>
  </div>
{% endif %}
